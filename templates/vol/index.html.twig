{% extends 'base.html.twig' %}

{% block title %}Liste des Vols{% endblock %}

{% block body %}

	<!-- Main Content Area -->
	<div class="space">
		<div class="container">
			<!-- Search Form -->
			<div class="card mb-4 search-section">
				<div class="card-header bg-primary text-white">
					<h5 class="mb-0"><i class="fas fa-search me-2"></i>Recherche de Vols</h5>
				</div>
				<div class="card-body">
					<form method="get" action="{{ path('app_vol_index') }}" class="row g-3" id="searchForm">
						<div class="col-md-3">
							<div class="form-group">
								<label class="form-label"><i class="fas fa-plane-departure me-2"></i>Recherche</label>
								<input type="text" name="search" class="form-control search-input" placeholder="Rechercher un vol..." value="{{ search }}">
							</div>
						</div>
						<div class="col-md-2">
							<div class="form-group">
								<label class="form-label"><i class="fas fa-map-marker-alt me-2"></i>Départ</label>
								<input type="text" name="departure" class="form-control search-input" placeholder="Ville de départ" value="{{ departure }}">
							</div>
						</div>
						<div class="col-md-2">
							<div class="form-group">
								<label class="form-label"><i class="fas fa-map-marker-alt me-2"></i>Arrivée</label>
								<input type="text" name="destination" class="form-control search-input" placeholder="Ville d'arrivée" value="{{ destination }}">
							</div>
						</div>
						<div class="col-md-2">
							<div class="form-group">
								<label class="form-label"><i class="far fa-clock me-2"></i>Heure</label>
								<input type="time" name="departure_time" class="form-control search-input" value="{{ departureTime }}" placeholder="Heure de départ">
							</div>
						</div>
						<div class="col-md-2">
							<div class="form-group">
								<label class="form-label"><i class="fas fa-tag me-2"></i>Prix Min</label>
								<div class="input-group">
									<span class="input-group-text">TND</span>
									<input type="number" name="min_price" class="form-control search-input" placeholder="Min" value="{{ minPrice }}" min="0" step="1">
								</div>
							</div>
						</div>
						<div class="col-md-2">
							<div class="form-group">
								<label class="form-label"><i class="fas fa-tag me-2"></i>Prix Max</label>
								<div class="input-group">
									<span class="input-group-text">TND</span>
									<input type="number" name="max_price" class="form-control search-input" placeholder="Max" value="{{ maxPrice }}" min="0" step="1">
								</div>
							</div>
						</div>
						<div class="col-md-3">
							<div class="form-group">
								<label class="form-label">&nbsp;</label>
								<button type="submit" class="btn btn-primary btn-block">
									<i class="fas fa-search me-2"></i>Rechercher
								</button>
							</div>
						</div>
						<div class="col-md-2">
							<label class="form-label d-block">&nbsp;</label>
							<button type="button" class="btn btn-secondary w-100 clear-btn" id="clearFilters">
								<i class="fas fa-times me-2"></i>Clear
							</button>
						</div>
					</form>
				</div>
			</div>

			{% if hasSearchParams and vols is empty %}
				<div class="alert alert-warning">
					<i class="fas fa-exclamation-circle me-2"></i>
					Aucun vol ne correspond à vos critères de recherche.
				</div>
			{% else %}
				<div class="row">
					{% for vol in vols %}
						<div class="col-lg-4 col-md-6 mb-4">
							<div class="flight-card">
								<div class="city-images">
									{% for image in vol.depart|city_images %}
										<img src="{{ image.url }}" alt="{{ vol.depart }}" data-city="departure" {% if loop.first %}class="active"{% endif %}>
									{% endfor %}
									{% for image in vol.destination|city_images %}
										<img src="{{ image.url }}" alt="{{ vol.destination }}" data-city="arrival">
									{% endfor %}
									<div class="city-navigation">
										{% for image in vol.depart|city_images %}
											<button data-city="departure" data-index="{{ loop.index0 }}"></button>
										{% endfor %}
										{% for image in vol.destination|city_images %}
											<button data-city="arrival" data-index="{{ loop.index0 }}"></button>
										{% endfor %}
									</div>
								</div>
								<div class="flight-header">
									<h3>
										<span class="country-flag">{{ vol.depart|country_flag }}</span>
										{{ vol.depart }} → 
										<span class="country-flag">{{ vol.destination|country_flag }}</span>
										{{ vol.destination }}
									</h3>
									<span class="airline">{{ vol.compagnie }}</span>
								</div>
								<div class="flight-body">
									<div class="flight-time">
										<div class="departure">
											<i class="far fa-clock"></i>
											<span>{{ vol.heureDepart|date('H:i') }}</span>
											<small>{{ vol.depart }}</small>
										</div>
										<div class="flight-duration">
											<i class="fas fa-plane"></i>
										</div>
										<div class="arrival">
											<i class="far fa-clock"></i>
											<span>{{ vol.heureArrivee|date('H:i') }}</span>
											<small>{{ vol.destination }}</small>
										</div>
									</div>
									<div class="flight-details">
										<div class="detail-item">
											<i class="fas fa-tag"></i>
											<span>{{ vol.prix }} TND</span>
										</div>
										<div class="detail-item">
											<i class="fas fa-chair"></i>
											<span>{{ vol.classeChaise }}</span>
										</div>
										<div class="detail-item">
											<i class="fas fa-users"></i>
											<span>{{ vol.siegesDisponibles }} sièges</span>
										</div>
									</div>
								</div>
								<div class="flight-footer">
									<a href="{{ path('app_vol_show', {'id': vol.id}) }}" class="btn btn-primary">
										Voir les détails
									</a>
								</div>
							</div>
						</div>
					{% endfor %}
				</div>

				<!-- Pagination -->
				{% if totalPages > 1 %}
					<nav aria-label="Page navigation" class="mt-4">
						<ul class="pagination justify-content-center">
							{% if currentPage > 1 %}
								<li class="page-item">
									<a class="page-link" href="{{ path('app_vol_index', hasSearchParams ? {
										'page': currentPage - 1,
										'search': search,
										'departure': departure,
										'destination': destination,
										'min_price': minPrice,
										'max_price': maxPrice,
										'departure_time': departureTime
									} : {
										'page': currentPage - 1
									}) }}">Précédent</a>
								</li>
							{% endif %}
							
							{% for i in 1..totalPages %}
								<li class="page-item {{ i == currentPage ? 'active' : '' }}">
									<a class="page-link" href="{{ path('app_vol_index', hasSearchParams ? {
										'page': i,
										'search': search,
										'departure': departure,
										'destination': destination,
										'min_price': minPrice,
										'max_price': maxPrice,
										'departure_time': departureTime
									} : {
										'page': i
									}) }}">{{ i }}</a>
								</li>
							{% endfor %}
							
							{% if currentPage < totalPages %}
								<li class="page-item">
									<a class="page-link" href="{{ path('app_vol_index', hasSearchParams ? {
										'page': currentPage + 1,
										'search': search,
										'departure': departure,
										'destination': destination,
										'min_price': minPrice,
										'max_price': maxPrice,
										'departure_time': departureTime
									} : {
										'page': currentPage + 1
									}) }}">Suivant</a>
								</li>
							{% endif %}
						</ul>
					</nav>
				{% endif %}
			{% endif %}
		</div>
	</div>

	<!-- Floating Chat Button -->
	<div class="chat-button" id="chatButton">
		<i class="fas fa-robot"></i>
		<span>Assistant Vol</span>
	</div>

	<!-- Chat Popup -->
	<div class="chat-popup" id="chatPopup">
		<div class="chat-header">
			<h3>
				<i class="fas fa-robot"></i>
				Assistant Vol
			</h3>
			<button class="close-chat" id="closeChat">
				<i class="fas fa-times"></i>
			</button>
		</div>
		<div class="chat-messages" id="chatbot-messages">
			<div class="message bot">
				<div class="message-content">
					Bonjour ! Je suis votre assistant de voyage. Comment puis-je vous aider aujourd'hui ?
				</div>
			</div>
		</div>
		<div class="chat-input">
			<form id="chatbot-form" class="d-flex">
				<input type="text" id="user-input" class="form-control" placeholder="Posez votre question..." required>
				<button type="submit" class="btn btn-primary">
					<i class="fas fa-paper-plane"></i>
				</button>
			</form>
		</div>
	</div>
{% endblock %}

