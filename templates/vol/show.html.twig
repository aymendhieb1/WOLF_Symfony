				// Initialize main tabs
				const flightTabs = document.querySelectorAll('#flightTabs button');
				flightTabs.forEach(tab => {
					tab.addEventListener('shown.bs.tab', (event) => {
						if (event.target.id === 'city-info-tab') {
							// Load all city information when switching to city info tab
							fetchCountryNews('{{ vol.depart }}', 'departureNews');
							fetchAlerts('{{ vol.depart }}', 'departureAlerts');
							fetchCityGeneralInfo('{{ vol.depart }}', 'departureGeneralInfo');
							fetchCityGeneralInfo('{{ vol.destination }}', 'destinationGeneralInfo');
						}
					});
				});
	
				// Initialize city tabs
				document.getElementById('departure-tab').addEventListener('shown.bs.tab', () => {
					if (document.getElementById('city-info-tab').classList.contains('active')) {
						fetchCountryNews('{{ vol.depart }}', 'departureNews');
						fetchAlerts('{{ vol.depart }}', 'departureAlerts');
						fetchCityGeneralInfo('{{ vol.depart }}', 'departureGeneralInfo');
					}
				});
	
				document.getElementById('destination-tab').addEventListener('shown.bs.tab', () => {
					if (document.getElementById('city-info-tab').classList.contains('active')) {
						fetchCountryNews('{{ vol.destination }}', 'destinationNews');
						fetchAlerts('{{ vol.destination }}', 'destinationAlerts');
						fetchCityGeneralInfo('{{ vol.destination }}', 'destinationGeneralInfo');
					}
				});
	
				// Initialize slideshows with more images
				document.querySelectorAll('.city-slideshow').forEach(slideshow => {
					const slides = slideshow.querySelectorAll('.slide');
					const prevBtn = slideshow.querySelector('.prev-btn');
					const nextBtn = slideshow.querySelector('.next-btn');
					let currentSlide = 0;
	
					function showSlide(index) {
						slides.forEach(slide => slide.classList.remove('active'));
						slides[index].classList.add('active');
					}
	
					prevBtn.addEventListener('click', () => {
						currentSlide = (currentSlide - 1 + slides.length) % slides.length;
						showSlide(currentSlide);
					});
	
					nextBtn.addEventListener('click', () => {
						currentSlide = (currentSlide + 1) % slides.length;
						showSlide(currentSlide);
					});
	
					// Auto-advance slides every 4 seconds
					setInterval(() => {
						currentSlide = (currentSlide + 1) % slides.length;
						showSlide(currentSlide);
					}, 4000);
				});
	
				// Initialize map
				const map = L.map('map').setView([0, 0], 2);
				L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
					maxZoom: 19,
					attribution: '© OpenStreetMap contributors'
				}).addTo(map);
	
				// Get coordinates for map
				async function getCoordinates(city) {
					try {
						const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(city)}`);
						const data = await response.json();
						if (data && data.length > 0) {
							return [parseFloat(data[0].lat), parseFloat(data[0].lon)];
						}
						return null;
					} catch (error) {
						console.error('Error fetching coordinates:', error);
						return null;
					}
				}
	
				// Add flight path to map
				async function addFlightPath() {
					const departCoords = await getCoordinates('{{ vol.depart }}');
					const destCoords = await getCoordinates('{{ vol.destination }}');
	
					if (departCoords && destCoords) {
						const departMarker = L.marker(departCoords).addTo(map).bindPopup('Départ: {{ vol.depart }}');
						const destMarker = L.marker(destCoords).addTo(map).bindPopup('Arrivée: {{ vol.destination }}');
	
						const flightPath = L.polyline([departCoords, destCoords], {
							color: '#ff681a',
							weight: 3,
							opacity: 0.7,
							dashArray: '10, 10'
						}).addTo(map);
	
						map.fitBounds(flightPath.getBounds());
					}
