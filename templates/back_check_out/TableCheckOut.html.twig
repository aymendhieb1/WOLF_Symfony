                /* Enhanced Select Styles to match search */
                #currencySort {
                    height: 48px;
                    border-radius: 12px;
                    border: 2px solid transparent;
                    padding: 0 16px;
                    font-size: 1rem;
                    background: linear-gradient(135deg, #ffffff, #f8f9fa);
                    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
