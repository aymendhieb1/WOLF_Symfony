                    }

                .pagination .page-item {
                    margin: 0 2px;
                }
                
                .pagination .page-link {
                    border-radius: 8px;
                    padding: 8px 16px;
                    color: #666;
                    border: 1px solid #e0e0e0;
                    background: white;
                    transition: all 0.3s ease;
                }
                
                .pagination .page-item.active .page-link {
                    background: #ff5722;
                    border-color: #ff5722;
                    color: white;
                }

                .pagination .page-link:hover {
                    background: #f8f9fa;
                    border-color: #ff5722;
                    color: #ff5722;
                }
                
                .pagination .page-item.disabled .page-link {
                    background: #f8f9fa;
                    border-color: #e0e0e0;
                    color: #999;
                }
                
                /* Responsive Adjustments */
                @media (max-width: 1200px) {
                    .col-xl-2-4 {
                        flex: 0 0 25%;
                        max-width: 25%;
                    }
                }

                @media (max-width: 992px) {
                    .col-lg-2-4 {
                        flex: 0 0 33.333333%;
                        max-width: 33.333333%;
                }
                }

                @media (max-width: 768px) {
                    .col-md-3 {
                        flex: 0 0 50%;
                        max-width: 50%;
                    }
                }

                @media (max-width: 576px) {
                    .col-sm-4 {
                        flex: 0 0 100%;
                        max-width: 100%;
                    }
                }

                /* Grid spacing */
                .row.g-4 {
                    --bs-gutter-x: 1.5rem;
                    --bs-gutter-y: 1.5rem;
                }

                .row.g-4 > * {
                    padding-right: calc(var(--bs-gutter-x) * .5);
                    padding-left: calc(var(--bs-gutter-x) * .5);
                    margin-top: var(--bs-gutter-y);
                }
            </style>

            <footer class="footer">
