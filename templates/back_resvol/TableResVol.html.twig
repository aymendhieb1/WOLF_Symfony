	<script>
		// Initialize the map with a fixed view centered on Tunisia
		const map = L.map('reservationMap', {
			center: [36.8, 10.2],  // Tunisia's approximate center
			zoom: 6,  // Zoom level to show Tunisia well
			zoomControl: true,
			maxZoom: 18,
			minZoom: 2,
			preferCanvas: true,  // Better performance
			updateWhenIdle: true,  // Update tiles when panning stops
			updateWhenZooming: false  // Don't update tiles while zooming
		});

		// Add OpenStreetMap tile layer with proper options
		L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
			attribution: '© OpenStreetMap contributors',
			maxZoom: 19,
			minZoom: 2,
			subdomains: 'abc',  // Use multiple subdomains for better loading
			tileSize: 256,
			zoomOffset: 0,
			detectRetina: true,  // Better support for retina displays
			updateWhenIdle: true,
			updateWhenZooming: false
		}).addTo(map);

		// Create custom icons for departure and arrival
		const departureIcon = L.divIcon({
			className: 'departure-marker',
			html: '<i class="material-icons marker-icon" style="color: #4CAF50;">flight_takeoff</i>',
			iconSize: [20, 20],
			iconAnchor: [10, 10]
		});

		const arrivalIcon = L.divIcon({
			className: 'arrival-marker',
			html: '<i class="material-icons marker-icon" style="color: #F44336;">flight_land</i>',
			iconSize: [20, 20],
			iconAnchor: [10, 10]
		});

		// Function to geocode a location
		async function geocodeLocation(location) {
			try {
				const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(location)}`);
				const data = await response.json();
				if (data && data.length > 0) {
					return {
						lat: parseFloat(data[0].lat),
						lon: parseFloat(data[0].lon)
					};
				}
				return null;
			} catch (error) {
				console.error('Geocoding error:', error);
				return null;
			}
		}

		// Process each reservation
		async function processReservations() {
			const reservations = [];
			{% for res_vol in res_vols %}
				reservations.push({
					depart: "{{ res_vol.departure }}",
					destination: "{{ res_vol.destination }}",
					dateReservation: "{{ res_vol.volReservationDate|date('d/m/Y H:i') }}",
					departureTime: "{{ res_vol.departureTime|date('d/m/Y H:i') }}",
					arrivalTime: "{{ res_vol.arrivalTime|date('d/m/Y H:i') }}",
					user: "{{ res_vol.user ? res_vol.user.nom ~ ' ' ~ res_vol.user.prenom : 'N/A' }}",
					prix: "{{ res_vol.flightPrice }}"
				});
			{% endfor %}

			for (const reservation of reservations) {
				const departCoords = await geocodeLocation(reservation.depart);
				const destCoords = await geocodeLocation(reservation.destination);

				if (departCoords && destCoords) {
					// Add departure marker
					L.marker([departCoords.lat, departCoords.lon], {
						icon: departureIcon
					}).bindPopup(`
						<div class="marker-popup">
							<h3>Départ: ${reservation.depart}</h3>
							<p>Heure de départ: ${reservation.departureTime}</p>
							<p>Date de réservation: ${reservation.dateReservation}</p>
							<p>Passager: ${reservation.user}</p>
							<p>Prix: ${reservation.prix} TND</p>
						</div>
					`).addTo(map);

					// Add arrival marker
					L.marker([destCoords.lat, destCoords.lon], {
						icon: arrivalIcon
					}).bindPopup(`
						<div class="marker-popup">
							<h3>Arrivée: ${reservation.destination}</h3>
							<p>Heure d'arrivée: ${reservation.arrivalTime}</p>
							<p>Date de réservation: ${reservation.dateReservation}</p>
							<p>Passager: ${reservation.user}</p>
							<p>Prix: ${reservation.prix} TND</p>
						</div>
					`).addTo(map);

					// Add flight path
					L.polyline([
						[departCoords.lat, departCoords.lon],
						[destCoords.lat, destCoords.lon]
					], {
						className: 'flight-path',
						color: '#ff5722',
						weight: 2,
						opacity: 0.8,
						dashArray: '5, 5'
					}).addTo(map);
				}
			}
		}

		// Add event listeners to handle map state
		map.on('zoomstart', function() {
			// Disable tile updates during zoom
			map.options.updateWhenZooming = false;
		});

		map.on('zoomend', function() {
			// Re-enable tile updates after zoom
			map.options.updateWhenZooming = true;
			map.invalidateSize();
		});

		map.on('moveend', function() {
			// Ensure tiles are loaded after moving
			map.invalidateSize();
		});

		// Handle tab visibility changes
		document.addEventListener('visibilitychange', function() {
			if (!document.hidden) {
				map.invalidateSize();
			}
		});

		// Update the tab shown handler
		$('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
			$('.nav-tabs .nav-link').css('color', '#000');
			const target = $(e.target).attr('href');
			if (target === '#map') {
				// Force the map to stay centered on Tunisia
				map.setView([36.8, 10.2], 6);
				// Ensure tiles are loaded
				setTimeout(function () {
					map.invalidateSize();
					// Force a tile reload
					map.eachLayer(function(layer) {
						if (layer instanceof L.TileLayer) {
							layer.redraw();
						}
					});
				}, 100);
			}
		});

		// Add error handling for tile loading
		map.on('tileerror', function(e) {
			console.warn('Tile loading error:', e);
			// Retry loading the tile
			e.tile.src = e.url;
		});

		// Start processing when the page is loaded
		document.addEventListener('DOMContentLoaded', function() {
			processReservations();
		});

		// Handle tab clicks and ensure text color
		$('.nav-tabs a').on('click', function (e) {
			e.preventDefault();
			$(this).tab('show');
			$('.nav-tabs .nav-link').removeClass('active');
			$(this).addClass('active');
			// Force black color on all tabs
			$('.nav-tabs .nav-link').css('color', '#000');
		});

		// Force initial text color
		$('.nav-tabs .nav-link').css('color', '#000');

		$(document).ready(function() {
			// Initialize DataTable
			$('#resvol-datatables').DataTable({
				"pagingType": "full_numbers",
				"lengthMenu": [
					[10, 25, 50, -1],
					[10, 25, 50, "Tous"]
				],
				"pageLength": 10,
				"paging": true,
				"ordering": true,
				"info": true,
				"searching": true,
				"responsive": true,
				"language": {
					"search": "_INPUT_",
