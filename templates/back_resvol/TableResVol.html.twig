					"targets": -1,
					"orderable": false
				}],
				"order": [[0, 'desc']],
				"dom": '<"top"lf>rt<"bottom"ip><"clear">'
			});

			// Initialize tooltips
			$('[data-toggle="tooltip"]').tooltip();

			// Initialize Charts
			// Monthly Reservations Chart
			const monthlyCtx = document.getElementById('monthlyChart');
			if (monthlyCtx) {
				new Chart(monthlyCtx.getContext('2d'), {
					type: 'bar',
					data: {
						labels: {{ monthly_labels|json_encode|raw }},
						datasets: [{
							label: 'Nombre de Réservations',
							data: {{ monthly_data|json_encode|raw }},
							backgroundColor: 'rgba(255, 87, 34, 0.8)',
							borderColor: 'rgba(255, 87, 34, 1)',
							borderWidth: 1
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: {
								display: false
							},
							title: {
								display: true,
								text: 'Réservations par Mois'
							}
						},
						scales: {
							y: {
								beginAtZero: true,
								ticks: {
									stepSize: 1
								}
							}
						}
					}
				});
			}

			// Destinations Chart
			const destinationCtx = document.getElementById('destinationChart');
			if (destinationCtx) {
				new Chart(destinationCtx.getContext('2d'), {
					type: 'bar',
					data: {
						labels: {{ destination_labels|json_encode|raw }},
						datasets: [{
							label: 'Nombre de Réservations',
							data: {{ destination_data|json_encode|raw }},
							backgroundColor: 'rgba(33, 150, 243, 0.8)',
							borderColor: 'rgba(33, 150, 243, 1)',
							borderWidth: 1
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: {
								display: false
							},
							title: {
								display: true,
								text: 'Destinations Populaires'
							}
						},
						scales: {
							y: {
								beginAtZero: true,
								ticks: {
									stepSize: 1
								}
							}
						}
					}
				});
			}

			// Airline Preferences Chart
			const airlineCtx = document.getElementById('airlineChart');
			if (airlineCtx) {
				new Chart(airlineCtx.getContext('2d'), {
					type: 'doughnut',
					data: {
						labels: {{ airline_labels|json_encode|raw }},
						datasets: [{
							data: {{ airline_data|json_encode|raw }},
							backgroundColor: [
								'rgba(255, 87, 34, 0.8)',
								'rgba(255, 152, 0, 0.8)',
								'rgba(76, 175, 80, 0.8)',
								'rgba(33, 150, 243, 0.8)',
								'rgba(156, 39, 176, 0.8)'
							],
							borderColor: [
								'rgba(255, 87, 34, 1)',
								'rgba(255, 152, 0, 1)',
								'rgba(76, 175, 80, 1)',
								'rgba(33, 150, 243, 1)',
								'rgba(156, 39, 176, 1)'
							],
							borderWidth: 1
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: {
								position: 'right',
								labels: {
									padding: 20,
									font: {
										size: 12
									}
								}
							},
							title: {
								display: true,
								text: 'Préférences des Compagnies'
							}
						}
					}
				});
			}

			// Price Distribution Chart
			const priceCtx = document.getElementById('priceChart');
			if (priceCtx) {
				new Chart(priceCtx.getContext('2d'), {
					type: 'bar',
					data: {
						labels: {{ price_labels|json_encode|raw }},
						datasets: [{
							label: 'Nombre de Réservations',
							data: {{ price_data|json_encode|raw }},
							backgroundColor: 'rgba(255, 152, 0, 0.8)',
							borderColor: 'rgba(255, 152, 0, 1)',
							borderWidth: 1
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: {
								display: false
							},
							title: {
								display: true,
								text: 'Distribution des Prix'
							}
						},
						scales: {
							y: {
								beginAtZero: true,
								ticks: {
									stepSize: 1
								}
							}
						}
					}
				});
			}
		});
	</script>

