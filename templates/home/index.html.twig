{% block javascripts %}
	{{parent()}}
	<script>
		document.addEventListener('DOMContentLoaded', function () {
const inputField = document.getElementById('user-question');
const recordButton = document.getElementById('start-record-btn');
const chatForm = document.getElementById('chat-form');

if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
const recognition = new SpeechRecognition();
recognition.lang = 'fr-FR';
recognition.continuous = false;
recognition.interimResults = false;

recordButton.addEventListener('click', function () {
recognition.start();
});

recognition.onresult = function (event) {
const transcript = event.results[0][0].transcript;
inputField.value = transcript;

// ✅ Dès que la reconnaissance est terminée, envoyer automatiquement
chatForm.requestSubmit(); // envoie directement le formulaire
};

recognition.onerror = function (event) {
console.error('Erreur de reconnaissance vocale :', event.error);
};
} else {
recordButton.disabled = true;
recordButton.innerText = 'Non supporté';
}
});
	</script>
