{% extends 'base.html.twig' %}

{% block title %}Erreur de Paiement{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Erreur de Paiement</h4>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="fas fa-exclamation-circle text-danger" style="font-size: 4rem;"></i>
                        <h2 class="mt-3">Une Erreur est Survenue</h2>
                        <p class="lead">{{ error_message }}</p>
                    </div>

                    <div class="text-center mt-4">
                        <a href="{{ path('app_vol_index') }}" class="btn btn-primary me-2">
                            <i class="fas fa-plane"></i> Retour aux Vols
                        </a>
                        {% if vol_id is defined and flightPrice is defined %}
                            <a href="{{ path('app_payment_vol', {'volId': vol_id, 'amount': flightPrice}) }}" class="btn btn-outline-primary">
                                <i class="fas fa-redo"></i> Réessayer
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 